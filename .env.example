# Copia este archivo como .env en la raíz del repositorio (junto a docker-compose.yml).
# docker compose lo lee automáticamente. El .env real NO se sube a git.

# ---- Seguridad ----
# Secreto compartido para firmar (auth) y verificar (entrenamiento, notificaciones) los JWT.
# Genera uno propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=24h

# ---- RabbitMQ (contenedor) ----
RABBITMQ_USER=gymflow
RABBITMQ_PASSWORD=gymflow_dev

# ---- PostgreSQL del servicio de autenticación (contenedor) ----
AUTH_DB_USER=gymflow_auth
AUTH_DB_PASSWORD=auth_dev_password

# ---- SQL Server del servicio de entrenamiento (instalado en la PC) ----
# Los contenedores llegan a la PC con host.docker.internal. Dentro de Docker (Linux)
# no existe la autenticación de Windows: se usa un login SQL con permisos solo sobre GymFlow.
# Ver README > "Preparar SQL Server" para crearlo.
SQL_SERVER=host.docker.internal
SQL_PORT=1433
SQL_DATABASE=GymFlow
SQL_USER=gymflow_app
SQL_PASSWORD=
SQL_ENCRYPT=false

# ---- MongoDB del servicio de entrenamiento (instalado en la PC) ----
ENTRENAMIENTO_MONGO_URI=mongodb://host.docker.internal:27017/gym_app

# ---- Frontend / Gateway ----
VITE_API_URL=http://localhost:8080/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
