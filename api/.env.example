# API
PORT=5000
NODE_ENV=development

# MongoDB local (MongoDB Server; Compass sirve para inspeccionar la misma instancia)
MONGO_URI=mongodb://127.0.0.1:27017/gym_app

# SQL Server con autenticación integrada de Windows (sin usuario ni contraseña SQL)
# Usa el nombre de servidor/instancia que aparece en SSMS, por ejemplo localhost\SQLEXPRESS
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=GymFlow
SQL_TRUSTED_CONNECTION=true
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Sustituye este valor por una cadena aleatoria propia en tu api/.env local
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h
